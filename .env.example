# CampusHub — copy to .env and adapt. Never commit the .env file.
# Every value has a development default: `docker compose up` also works without a .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=campushub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=campushub
# Port published on the host (change it if a local PostgreSQL already uses 5432).
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# development | test | production. In production: Secure cookies, no /api/docs.
ENVIRONMENT=development
# Used when the backend runs outside Docker (docker compose builds its own URL).
DATABASE_URL=postgresql+psycopg://campushub:change-me@localhost:5432/campushub
# Origins allowed to send authenticated, state-changing requests (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TTL_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- Frontend (Next.js) ---
# Where Next.js forwards /api/* (FastAPI). Default: http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# --- Links and e-mail ---
# Public address of the site (invitation and password-reset links).
FRONTEND_URL=http://localhost:3000
# console = e-mails printed in the backend logs; smtp = real delivery (any provider).
EMAIL_BACKEND=console
EMAIL_FROM=CampusHub <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
